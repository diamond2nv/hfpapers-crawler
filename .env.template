
# SERVER_HOST=your_server_ip  # Server IP address for remote deployment
#
# Zotero remote API URL
# Set to point hfpclawer at a remote Zotero instance (e.g. WSL Windows).
# Host header is automatically spoofed as "localhost:23119".
# Examples:
#   ZOTERO_API_URL=http://192.168.0.103:23120  # WSL via socat bridge
#   ZOTERO_API_URL=http://localhost:23119        # local Zotero (default)
# ZOTERO_API_URL=
